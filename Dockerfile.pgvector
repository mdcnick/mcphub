# syntax=docker/dockerfile:1
FROM golang:1.27.4-bookworm@sha256:fb7cceb528b47141eccd9b60bf3cbd27d5ef5f8cf5b7d338bec866da495b50dc AS builder
WORKDIR /src
ADD https://github.com/tianon/gosu.git#29b939aa5bd4dc588af765b8248f6e39150d2565 /src/
RUN CGO_ENABLED=0 go build -trimpath -mod=readonly -o /out/gosu . && go version -m /out/gosu

FROM pgvector/pgvector:0.8.7-pg17-bookworm@sha256:0a547a6067fdea4eec4cfb0887c4ddae2e91b1932cecc071541c14ee318312ce
COPY --from=builder /out/gosu /usr/local/bin/gosu
RUN gosu nobody true
